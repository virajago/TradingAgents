# =============================================================================
# Conviction — environment variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# --- Stripe — credit pack pricing --------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Three Stripe products (7-day free trial, card required upfront)
STRIPE_PRICE_STARTER=price_starter_...    # $19/month — 100 credits
STRIPE_PRICE_PRO=price_pro_...            # $39/month — 300 credits
STRIPE_PRICE_UNLIMITED=price_unlimited_.. # $79/month — 10 000 credits
STRIPE_TRIAL_DAYS=7
STRIPE_TRIAL_CREDITS=50                   # credits granted at trial start

# --- Resend -------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=weekly@aianalystweekly.com

# --- LLM APIs (route through Cloudflare AI Gateway for caching + analytics) --
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENAI_API_KEY=
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT/conviction

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# --- Loops.so (lifecycle email automation) ------------------------------------
LOOPS_API_KEY=

# --- Finnhub (red flag alerts) ------------------------------------------------
FINNHUB_API_KEY=your-finnhub-key

# --- App ----------------------------------------------------------------------
# Long random string — protects /internal/* routes called by Cloud Scheduler
INTERNAL_API_SECRET=generate-a-long-random-string-here

ENVIRONMENT=development
MAX_CONCURRENT_ANALYSES=20
MAX_ON_DEMAND_PER_DAY=10
