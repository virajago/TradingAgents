# Conviction — production environment
# Copy to .env.production and fill in values before running deploy.sh

# Supabase (from Project Settings → API)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...         # Phase 2+3 synthesis (quality)
GOOGLE_API_KEY=AIza...               # Phase 1 analysts (fast + cheap)
DEEPSEEK_API_KEY=sk-...              # Optional fallback

# LLM model config (defaults shown — change if needed)
ANALYST_PROVIDER=google
ANALYST_MODEL=gemini-2.5-flash
SYNTHESIS_PROVIDER=anthropic
SYNTHESIS_MODEL=claude-sonnet-4-6

# Stripe (from Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...      # from Stripe Dashboard → Webhooks (after first deploy)
STRIPE_PRICE_STARTER=price_...       # $19/month, 100 credits
STRIPE_PRICE_PRO=price_...           # $39/month, 300 credits
STRIPE_PRICE_UNLIMITED=price_...     # $79/month, 10,000 credits

# Email (from Resend dashboard)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=weekly@yourdomain.com

# Market data
FINNHUB_API_KEY=...                  # paid tier required for real-time alerts

# Lifecycle emails (optional)
LOOPS_API_KEY=...

# Security
INTERNAL_API_SECRET=<generate with: openssl rand -hex 32>

# App
MAX_CONCURRENT_ANALYSES=20
